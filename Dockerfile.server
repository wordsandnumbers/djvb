# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /build

COPY mvnw ./
COPY .mvn ./.mvn
COPY pom.xml ./
RUN --mount=type=secret,id=gh_pat \
    --mount=type=cache,target=/root/.m2 \
    GH_PAT=$(cat /run/secrets/gh_pat 2>/dev/null || echo "") && \
    GH_USER="${GH_USER:-x-access-token}" && \
    mkdir -p /root/.m2 && \
    printf '<settings><servers><server><id>github-vbclient</id><username>%s</username><password>%s</password></server></servers></settings>\n' \
        "$GH_USER" "$GH_PAT" > /root/.m2/settings.xml && \
    ./mvnw -B -q dependency:go-offline

COPY src ./src
RUN --mount=type=secret,id=gh_pat \
    --mount=type=cache,target=/root/.m2 \
    GH_PAT=$(cat /run/secrets/gh_pat 2>/dev/null || echo "") && \
    GH_USER="${GH_USER:-x-access-token}" && \
    mkdir -p /root/.m2 && \
    printf '<settings><servers><server><id>github-vbclient</id><username>%s</username><password>%s</password></server></servers></settings>\n' \
        "$GH_USER" "$GH_PAT" > /root/.m2/settings.xml && \
    ./mvnw -B -DskipTests package && \
    cp target/djvb-*.jar /build/app.jar

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

COPY --from=build /build/app.jar /app/app.jar
COPY docker/server-entrypoint.sh /usr/local/bin/server-entrypoint.sh
RUN chmod +x /usr/local/bin/server-entrypoint.sh

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["/usr/local/bin/server-entrypoint.sh"]
